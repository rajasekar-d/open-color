@use "sass:map";

//
//
//  𝗖 𝗢 𝗟 𝗢 𝗥
//  v {{version}}
//
//  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


//  General
//  ───────────────────────────────────

{{#each general as |color|}}
${{color.name}}:         {{color.hex}};
{{/each}}


{{#each colors as |color|}}
//  {{capitalize color.name}}
//  ───────────────────────────────────

${{color.name}}-list: (
{{#each color.hex as |hex index|}}
  "{{index}}": {{hex}}{{#unless @last}},{{/unless}}
{{/each}}
);

${{color.name}}-0: map.get(${{color.name}}-list, "0");
${{color.name}}-1: map.get(${{color.name}}-list, "1");
${{color.name}}-2: map.get(${{color.name}}-list, "2");
${{color.name}}-3: map.get(${{color.name}}-list, "3");
${{color.name}}-4: map.get(${{color.name}}-list, "4");
${{color.name}}-5: map.get(${{color.name}}-list, "5");
${{color.name}}-6: map.get(${{color.name}}-list, "6");
${{color.name}}-7: map.get(${{color.name}}-list, "7");
${{color.name}}-8: map.get(${{color.name}}-list, "8");
${{color.name}}-9: map.get(${{color.name}}-list, "9");


{{/each}}
//  Color list
//  ───────────────────────────────────

$color-spectrum:   {{spectrum}};

$color-list: (
{{#each colors as |color|}}
  ${{color.name}}-list:      "{{color.name}}"{{#unless @last}},{{/unless}}
{{/each}}
);
